model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description          String?
  icon                 String?
  categoryImage        String?
  categoryImagePublicId String?
  isActive             Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("categories")
}
